# norteia-lead-recon — example env vars
# Copy to .env (NEVER commit .env) and adjust for your operator setup.

# Optional: project root with apps/borme-parser and apps/worker-py runners.
# When present, the skill auto-detects and delegates to them instead of using
# its mini-parsers. Keep unset for standalone mode.
# LEAD_RECON_PROJECT_ROOT=/path/to/your/project

# Optional: Mission Control / CRM endpoint for /lead-cross.
# If MISSION_CONTROL_API_URL is set, /lead-cross hits the API.
# Otherwise it falls back to MISSION_CONTROL_LEADS_PATH (local JSON).
# MISSION_CONTROL_API_URL=https://your-crm.example.com/api
# MISSION_CONTROL_API_KEY=your-bearer-token
# MISSION_CONTROL_LEADS_PATH=~/mission-control/leads.json

# Optional: override BORME parser HTTP endpoint when running the project's
# `apps/borme-parser` server (default localhost:3030).
# BORME_PARSER_URL=http://localhost:3030

# Optional: override the worker-py spider endpoint (default localhost:8000).
# WORKER_PY_URL=http://localhost:8000
